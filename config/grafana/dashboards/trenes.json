    {
      "id": 16,
      "type": "timeseries",
      "title": "Retraso medio por hora (retrasos_hora)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-practica3"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-practica3"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT hora AS time, sum(retraso_medio * lecturas) / sum(lecturas) AS \"Retraso medio\" FROM retrasos_hora WHERE $__timeFilter(hora) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          },
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Retraso medio por nucleo y hora",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-practica3"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-practica3"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT h.hora AS time, n.nombre AS metric, sum(h.retraso_medio * h.lecturas) / sum(h.lecturas) AS value FROM retrasos_hora h JOIN lineas l ON l.id = h.linea_id JOIN nucleos n ON n.id = l.nucleo_id WHERE $__timeFilter(h.hora) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "always"
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      }
    },
