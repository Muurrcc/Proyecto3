          "query": "SELECT last(\"lat\") AS \"lat\", last(\"lon\") AS \"lon\", last(\"retraso\") AS \"retraso\", last(\"parada\") AS \"parada\" FROM \"trenes\" WHERE time > now() - 5m GROUP BY \"tren\", \"linea\", \"nucleo\"",
